rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.token.email != null
        && request.auth.token.email == "bagman250@gmail.com";
    }

    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isParticipant() {
      return signedIn()
        && resource.data.participants is list
        && request.auth.uid in resource.data.participants;
    }

    function createsOwnFavorite() {
      return signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.productId is string;
    }

    function updatesOnlyEngagement() {
      return signedIn()
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(["likes"])
        && request.resource.data.likes is int
        && request.resource.data.likes >= 0;
    }

    match /posts/{postId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.titulo is string
        && request.resource.data.precio is string
        && request.resource.data.imagenes is list;
      allow update: if isAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid)
        || updatesOnlyEngagement();
      allow delete: if isAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid);
    }

    match /users/{userId} {
      allow create: if isSelf(userId);
      allow read, update: if isAdmin() || isSelf(userId);
      allow delete: if isAdmin();
    }

    match /favorites/{favoriteId} {
      allow create: if createsOwnFavorite();
      allow read, update, delete: if isAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid);
    }

    match /reports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.reportedByUid == request.auth.uid;
      allow read, update, delete: if isAdmin();
    }

    match /supportMessages/{messageId} {
      allow create: if request.resource.data.name is string
        && request.resource.data.email is string
        && request.resource.data.reason is string
        && request.resource.data.message is string
        && request.resource.data.status == "open";
      allow read, update, delete: if isAdmin();
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.sellerEmail is string
        && request.resource.data.comment is string
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5;
      allow update, delete: if isAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid);
    }

    match /notifications/{notificationId} {
      allow create: if signedIn();
      allow read, update, delete: if isAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid);
    }

    match /conversations/{conversationId} {
      allow create: if signedIn()
        && request.resource.data.participants is list
        && request.auth.uid in request.resource.data.participants;
      allow read, update, delete: if isAdmin() || isParticipant();

      match /messages/{messageId} {
        allow read: if isAdmin()
          || (signedIn()
            && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants);
        allow create: if signedIn()
          && request.resource.data.senderId == request.auth.uid
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
        allow update, delete: if isAdmin();
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
